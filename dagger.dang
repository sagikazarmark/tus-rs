type Tus {
  let rust: Rust!

  new(ws: Workspace!, rustVersion: String!) {
    self.rust = Dagger.rust(ws: ws, version: rustVersion)

    self
  }

  """
  The tus CLI binary.
  """
  cli: File! {
    self.rust.build(bin: ["tus"]).file("tus")
  }

  """
  The tus server binary.
  """
  server: File! {
    self.rust.build(bin: ["tus-server"]).file("tus-server")
  }
}
