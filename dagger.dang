type Tus {
  let rust: Rust!

  new {
    self.rust = Dagger.rust(version: "1.97-trixie")

    self
  }

  """
  The tus CLI binary.
  """
  cli(ws: Workspace!): File! {
    self.rust.build(ws, bin: ["tus"]).file("tus")
  }

  """
  The tus server binary.
  """
  server(ws: Workspace!): File! {
    self.rust.build(ws, bin: ["tus-server"]).file("tus-server")
  }
}
