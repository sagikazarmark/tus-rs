type Demo {
  let dioxus: Dioxus!
  let tus: Tus!

  new(
    ws: Workspace!,
    """
    Version (image tag) to use from the official Rust image repository as a base container.
    """
    rustVersion: String!,
    """
    Version (image tag) to use from the official Node image repository for building assets.
    """
    nodeVersion: String! = "latest",
    """
    wasm-pack version to use for building the service worker.
    """
    wasmPackVersion: String! = "v0.15.0",
  ) {
    # clang is needed to cross-compile the C sysroot pulled in
    # by the `dioxus-code` snippet highlighter (arborium/tree-sitter) for the wasm32 target.
    # The `cc` crate auto-selects clang for wasm32-unknown-unknown, so installing it is enough.
    let rustContainer = Dagger
      .container
      .from("rust:" + rustVersion)
      .withMountedCache("/var/cache/apt/archives", Dagger.cacheVolume("debian-apt-archives"))
      .withEnvVariable("DEBIAN_FRONTEND", "noninteractive")
      .withExec(["apt-get", "update"])
      .withExec(["apt-get", "install", "-y", "--no-install-recommends", "clang"])

    let node = Dagger
      .container
      .from("node:" + nodeVersion)
      .withEnvVariable("NPM_CONFIG_CACHE", "/root/.npm")
      .withMountedCache("${NPM_CONFIG_CACHE}", Dagger.cacheVolume("npm"), expand: true)
      .withWorkdir("/work/src")
      .withMountedDirectory("", ws.directory("", gitignore: true))
      .withExec(["npm", "ci"])

    let style = node
      .withExec(["npm", "run", "build"])
      .file("assets/style.css")

    # The Dioxus toolchain ships wasm-pack and a wasm-bindgen CLI matching Cargo.lock,
    # so it doubles as the build environment for the service worker.
    let serviceWorker = Dagger
      .dioxus(ws: ws, container: rustContainer, wasmPackVersion: wasmPackVersion)
      .container
      .withExec([
        "wasm-pack", "build", "./service-worker",
        "--target", "web",
        "--release",
        "--no-typescript",
        "--no-pack",
        "--out-dir", "/work/out/service-worker",
        "--out-name", "service_worker",
      ])
      .directory("/work/out/service-worker")
      .withoutFile(".gitignore")

    # The demo is its own Cargo workspace: build tus-server from the repository root
    # (withWorkdir takes a path relative to the workspace root).
    self.tus = Dagger.tus(ws: ws.withWorkdir("."), rustVersion: rustVersion)

    # Generated assets are ignored by git, so they are mounted on the workspace.
    # (withDirectory diffs against the unfiltered host content, so it is a no-op
    # when identical, already generated assets exist locally.)
    ws = ws
      .withMountedFile("assets/style.css", style)
      .withMountedDirectory("public/service-worker", serviceWorker)

    self.dioxus = Dagger.dioxus(ws: ws, container: rustContainer, wasmPackVersion: wasmPackVersion)

    self
  }

  """
  Build the demo application.
  """
  build(
    """
    Use the browser-local endpoint by default instead of the native server.
    """
    browserLocal: Boolean! = false,
  ): Directory! @check {
    self
      .dioxus
      .withEnvVariable("DEMO_BROWSER_LOCAL", toString(browserLocal))
      .bundle(
        release: true,
        debugSymbols: false,
        package: "demo",
        platform: DioxusPlatform.WEB,
      )
  }

  """
  Serve the demo application.
  """
  service(
    """
    Use the browser-local endpoint by default instead of the native server.
    """
    browserLocal: Boolean! = false,
  ): Service! @up {
    self
      .dioxus
      .withEnvVariable("DEMO_BROWSER_LOCAL", toString(browserLocal))
      .serve(package: "demo", port: 8080)
  }

  """
  Tus server service.
  """
  server: Service! @up {
    Dagger
      .container
      .from("debian:trixie")
      # tus-server builds a reqwest/rustls HTTP client at startup (via
      # OpenDAL's default registry), which panics without system CA
      # certificates. The stock debian:trixie image ships none.
      .withEnvVariable("DEBIAN_FRONTEND", "noninteractive")
      .withExec(["apt-get", "update"])
      .withExec(["apt-get", "install", "-y", "--no-install-recommends", "ca-certificates"])
      .withFile("/usr/local/bin/tus-server", self.tus.server)
      .withExec(["mkdir", "-p", "/data", "/state"])
      .withExposedPort(8081)
      .asService(args: [
        "tus-server",
        "serve",
        "--addr", "0.0.0.0:8081",
        "--base-url", "http://localhost:8081",
        "--all-extensions",
        "--cors",
        "--storage-uri", "fs:///data",
        "--state-dir", "/state",
      ])
  }

  """
  The Cloudflare Worker bundle.
  """
  workerBundle: Directory! @check {
    Dagger
      .directory
      .withDirectory("dist", self.build(browserLocal: true))
  }

  """
  The Cloudflare Worker bundle as a container (for module wiring).
  """
  workerBundleAsContainer: Container! {
    Dagger.container.withDirectory("", self.workerBundle)
  }
}
