type Demo {
  let jsEnv: JavascriptEnvironment!
  let dioxus: Dioxus!

  new(rustVersion: String!) {
    # Shared base container: the official Rust image plus clang. clang is needed
    # to cross-compile the C sysroot pulled in by the `dioxus-code` snippet
    # highlighter (arborium/tree-sitter) for the wasm32 target. The `cc` crate
    # auto-selects clang for wasm32-unknown-unknown, so installing it is enough.
    let rustContainer = Dagger
      .container
      .from("rust:" + rustVersion)
      .withMountedCache("/var/cache/apt/archives", Dagger.cacheVolume("debian-apt-archives"))
      .withEnvVariable("DEBIAN_FRONTEND", "noninteractive")
      .withExec(["apt-get", "update"])
      .withExec(["apt-get", "install", "-y", "--no-install-recommends", "clang"])

    self.jsEnv = Dagger.javascriptEnvironment(install: true, locked: true)
    self.dioxus = Dagger.dioxus(container: rustContainer)

    self
  }

  let withAssets(ws: Workspace!): Workspace! {
    let assets = self.jsEnv.withRun(ws, "build").directory("assets")

    # DAGGER_TODO: need better way to pass module outputs to other modules
    let dir = ws
      .directory("/", gitignore: true)
      .withDirectory(ws.cwd + "/assets", assets)

    # DAGGER_TODO:
    # assets is normally ignored by git
    # so adding it back causes it to be ignored next time workspace is called
    dir = dir
      .withFile(
        "demo/.gitignore",
        dir.file("demo/.gitignore").withReplaced("/assets/", ""),
      )

    dir.asWorkspace(ws.cwd)
  }

  """
  Build the dioxus-tus demo application.
  """
  build(ws: Workspace!): Directory! @check {
    self.dioxus.bundle(
      self.withAssets(ws),
      release: true,
      debugSymbols: false,
      platform: DioxusPlatform.WEB,
    )
  }

  """
  Serve the dioxus-tus demo application.
  """
  service(ws: Workspace!): Service! @up {
    self.dioxus.serve(self.withAssets(ws), port: 8080)
  }

  """
  Tus server service.
  """
  server(ws: Workspace!): Service! @up {
    # DAGGER_TODO: need a way to change cwd OR call a remote workspace
    let ws = ws.directory("/", gitignore: true).asWorkspace("/")

    let binary = Dagger.tus.server(ws)

    Dagger
      .container
      .from("debian:trixie")
      # tus-server builds a reqwest/rustls HTTP client at startup (via
      # OpenDAL's default registry), which panics without system CA
      # certificates. The stock debian:trixie image ships none.
      .withEnvVariable("DEBIAN_FRONTEND", "noninteractive")
      .withExec(["apt-get", "update"])
      .withExec(["apt-get", "install", "-y", "--no-install-recommends", "ca-certificates"])
      .withFile("/usr/local/bin/tus-server", binary)
      .withExec(["mkdir", "-p", "/data", "/state"])
      .withExposedPort(8081)
      .asService(args: [
        "tus-server",
        "serve",
        "--addr", "0.0.0.0:8081",
        "--base-url", "http://localhost:8081",
        "--all-extensions",
        "--cors",
        "--storage-uri", "fs:///data",
        "--state-dir", "/state",
      ])
  }
}
