type Tests {
  let cliBinary: File!
  let serverBinary: File!

  new(ws: Workspace!, rustVersion: String!) {
    let tus = Dagger.tus(ws: ws, rustVersion: rustVersion)

    self.cliBinary = tus.cli
    self.serverBinary = tus.server

    self
  }

  """
  The tus CLI tests.
  """
  cli(tusdVersion: String! = "latest", rustusVersion: String! = "latest"): CliTests! {
    CliTests(self.cliBinary, tusdVersion, rustusVersion)
  }

  """
  The tus server tests.
  """
  server: ServerTests! {
    ServerTests(self.serverBinary)
  }
}

type ServerTests {
  """
  The tus-server binary under test.
  """
  let binary: File!

  """
  Run the tus protocol conformance suite against tus-server.
  """
  conformance: Directory! @check @cache(policy: FunctionCachePolicy.Never) {
    let server = Dagger
      .container
      .from("debian:trixie")
      .withExec(["mkdir", "-p", "/data", "/state"])
      .withMountedFile("/usr/local/bin/tus-server", self.binary)
      .withExposedPort(8080)
      .asService([
        "/usr/local/bin/tus-server",
        "serve",
        "--addr", "0.0.0.0:8080",
        "--base-url", "http://tus:8080",
        "--all-extensions",
        "--disable-concatenation-unfinished",
        "--expiration", "1h",
        "--storage-uri", "fs:///data",
        "--state-dir", "/state",
      ])
      .withHostname("tus")

    let result = Dagger
      .tusConformanceTests
      .test(
        service: server,
        extensions: TusConformanceTestsExtension.values.reject { _ == TusConformanceTestsExtension.CONCATENATION_UNFINISHED },
      )

    if (result.exitCode > 0) {
      raise result.output.file("stderr.log").contents
    }

    result.output
  }
}

type CliTests {
  """
  The tus CLI binary under test.
  """
  let cli: File!

  let tusdVersion: String!
  let rustusVersion: String!

  """
  Run the CLI test suite against the tusd server.
  """
  tusd: CliTestSuite! {
    let server = Dagger
      .container
      .from("tusproject/tusd:" + self.tusdVersion)
      .withUser("root")
      .withExposedPort(1080)
      .withDefaultArgs([
        "-host=0.0.0.0",
        "-port=1080",
        "-upload-dir=/srv/tusd/data",
      ])

    CliTestSuite(self.cli, server)
  }

  """
  Run the CLI test suite against the rustus server.
  """
  rustus: CliTestSuite! {
    let server = Dagger
      .container(platform: "linux/amd64")
      .from("s3rius/rustus:" + self.rustusVersion)
      .withEnvVariable("RUSTUS_SERVER_HOST", "0.0.0.0")
      .withEnvVariable("RUSTUS_SERVER_PORT", "1080")
      .withEnvVariable("RUSTUS_URL", "/files")
      .withEnvVariable("RUSTUS_MAX_BODY_SIZE", "1073741824")
      .withEnvVariable("RUSTUS_STORAGE", "file-storage")
      .withEnvVariable("RUSTUS_DATA_DIR", "/data")
      .withEnvVariable("RUSTUS_DIR_STRUCTURE", "flat")
      .withEnvVariable("RUSTUS_EXTENSIONS", "getting,creation,termination,creation-with-upload,creation-defer-length,concatenation,checksum")
      .withEnvVariable("RUSTUS_INFO_STORAGE", "file-info-storage")
      .withEnvVariable("RUSTUS_INFO_DIR", "/data/info")
      .withExec(["mkdir", "-p", "/data"])
      .withExposedPort(1080)

    CliTestSuite(self.cli, server)
  }
}

type CliTestSuite {
  let cli: File!
  let server: Container!

  new(cli: File!, server: Container!) {
    self.cli = cli
    self.server = server

    self
  }

  let client: Container! {
    Dagger
      .container
      .from("debian:trixie")
      .withEnvVariable("DEBIAN_FRONTEND", "noninteractive")
      .withExec(["apt-get", "update"])
      .withExec(["apt-get", "install", "-y", "--no-install-recommends", "ca-certificates", "curl"])
      .withMountedFile("/usr/local/bin/tus", self.cli)
  }

  basic: Void @check {
    let input = "hello from tus-rs dagger e2e\n"
    let service = self.server.asService(useEntrypoint: true)
    let client = self
      .client
      .withServiceBinding("server", service)
      .withNewFile("/tmp/input.txt", contents: input)
    let uploadUrl = client
      .withExec([
        "/usr/local/bin/tus",
        "--endpoint",
        "http://server:1080/files/",
        "upload",
        "--no-progress",
        "--output",
        "url",
        "/tmp/input.txt",
      ])
      .stdout
      .trimSuffix("\n")
    let content = client
      .withExec(["curl", "-fsS", uploadUrl])
      .stdout

    assert { content == input }
  }

  createUpload: Void @check {
    let input = "hello from tus-rs dagger create upload\n"
    let service = self.server.asService(useEntrypoint: true)
    let client = self
      .client
      .withServiceBinding("server", service)
      .withNewFile("/tmp/input.txt", contents: input)
    let uploadUrl = client
      .withExec([
        "/usr/local/bin/tus",
        "--endpoint",
        "http://server:1080/files/",
        "create",
        "--length",
        "39B",
      ])
      .stdout
      .trimSuffix("\n")
    let uploadedUrl = client
      .withExec([
        "/usr/local/bin/tus",
        "upload",
        "--no-progress",
        "--output",
        "url",
        "/tmp/input.txt",
        uploadUrl,
      ])
      .stdout
      .trimSuffix("\n")
    let content = client
      .withExec(["curl", "-fsS", uploadUrl])
      .stdout

    assert { uploadedUrl == uploadUrl }
    assert { content == input }
  }

  createInfo: Void @check {
    let service = self.server.asService(useEntrypoint: true)
    let client = self.client.withServiceBinding("server", service)
    let uploadUrl = client
      .withExec([
        "/usr/local/bin/tus",
        "--endpoint",
        "http://server:1080/files/",
        "create",
        "--length",
        "1KiB",
        "--metadata",
        "filename=created.bin",
      ])
      .stdout
      .trimSuffix("\n")
    let info = client
      .withExec([
        "/usr/local/bin/tus",
        "info",
        uploadUrl,
      ])
      .stdout
    let expected = "url: __UPLOAD_URL__\noffset: 0\nlength: 1024\nmetadata:\nfilename=created.bin\n".replace(
      "__UPLOAD_URL__",
      uploadUrl,
      1,
    )

    assert { info == expected }
  }

  createTerminate: Void @check {
    let service = self.server.asService(useEntrypoint: true)
    let client = self.client.withServiceBinding("server", service)
    let uploadUrl = client
      .withExec([
        "/usr/local/bin/tus",
        "--endpoint",
        "http://server:1080/files/",
        "create",
        "--length",
        "3",
      ])
      .stdout
      .trimSuffix("\n")
    let verify = client
      .withExec([
        "/usr/local/bin/tus",
        "terminate",
        uploadUrl,
      ])
      .withEnvVariable("UPLOAD_URL", uploadUrl)
      .withExec([
        "sh",
        "-c",
        "/usr/local/bin/tus info \"$UPLOAD_URL\" >/tmp/info.out 2>/tmp/info.err; test $? -ne 0",
      ])
      .stdout

    assert { verify == "" }
  }
}
