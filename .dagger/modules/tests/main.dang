type Tests {
  let tus: Tus!

  new {
    self.tus = Dagger.tus

    self
  }

  """
  The tus CLI tests.
  """
  cli(tusdVersion: String! = "latest", rustusVersion: String! = "latest"): CliTests! {
    CliTests(tusdVersion, rustusVersion)
  }

  """
  The tus server tests.
  """
  server: ServerTests! {
    ServerTests
  }
}

type ServerTests {
  """
  Run the tus protocol conformance suite against tus-server.
  """
  conformance: Void @check @cache(policy: FunctionCachePolicy.Never) {
    let server = Dagger
      .container
      .from("debian:trixie")
      .withExec(["mkdir", "-p", "/data", "/state"])
      .withMountedFile("/usr/local/bin/tus-server", Dagger.tus.server)
      .withExposedPort(1080)
      .asService([
        "/usr/local/bin/tus-server",
        "serve",
        "--addr", "0.0.0.0:1080",
        "--base-url", "http://tus:1080",
        "--all-extensions",
        "--disable-concatenation-unfinished",
        "--expiration", "1h",
        "--storage-uri", "fs:///data",
        "--state-dir", "/state",
      ])
      .withHostname("tus")
    let tests = Dagger
      .git("https://github.com/sagikazarmark/tus-compliance-tests.git")
      .branch("main")
      .tree
    let variables = Dagger
      .directory
      .withNewFile(
        "variables.env",
        "base_url=http://tus:1080/files\ntus_version=1.0.0\n",
      )
      .file("variables.env")
    let result = Dagger
      .hurl(version: "7.1.0")
      .withServiceBinding(server, port: 1080)
      .run(
        source: tests,
        test: true,
        globs: [
          "tests/core/**/*.hurl",
          "tests/extensions/checksum/**/*.hurl",
          "tests/extensions/checksum-trailer/**/*.hurl",
          "tests/extensions/concatenation/**/*.hurl",
          "tests/extensions/creation/**/*.hurl",
          "tests/extensions/creation-defer-length/**/*.hurl",
          "tests/extensions/creation-with-upload/**/*.hurl",
          "tests/extensions/expiration/**/*.hurl",
          "tests/extensions/termination/**/*.hurl",
        ],
        variablesFile: variables,
      )

    if (result.exitCode != 0) {
      raise result.stderr
    }

    assert { result.exitCode == 0 }
  }
}

type CliTests {
  let tusdVersion: String!
  let rustusVersion: String!

  """
  Run the CLI test suite against the tusd server.
  """
  tusd: CliTestSuite! {
    let server = Dagger
      .container
      .from("tusproject/tusd:" + self.tusdVersion)
      .withUser("root")
      .withExposedPort(1080)
      .withDefaultArgs([
        "-host=0.0.0.0",
        "-port=1080",
        "-upload-dir=/srv/tusd/data",
      ])

    CliTestSuite(server)
  }

  """
  Run the CLI test suite against the rustus server.
  """
  rustus: CliTestSuite! {
    let server = Dagger
      .container(platform: "linux/amd64")
      .from("s3rius/rustus:" + self.rustusVersion)
      .withEnvVariable("RUSTUS_SERVER_HOST", "0.0.0.0")
      .withEnvVariable("RUSTUS_SERVER_PORT", "1080")
      .withEnvVariable("RUSTUS_URL", "/files")
      .withEnvVariable("RUSTUS_MAX_BODY_SIZE", "1073741824")
      .withEnvVariable("RUSTUS_STORAGE", "file-storage")
      .withEnvVariable("RUSTUS_DATA_DIR", "/data")
      .withEnvVariable("RUSTUS_DIR_STRUCTURE", "flat")
      .withEnvVariable("RUSTUS_EXTENSIONS", "getting,creation,termination,creation-with-upload,creation-defer-length,concatenation,checksum")
      .withEnvVariable("RUSTUS_INFO_STORAGE", "file-info-storage")
      .withEnvVariable("RUSTUS_INFO_DIR", "/data/info")
      .withExec(["mkdir", "-p", "/data"])
      .withExposedPort(1080)

    CliTestSuite(server)
  }
}

type CliTestSuite {
  let server: Container!

  new(server: Container!) {
    self.server = server

    self
  }

  let client: Container! {
    Dagger
      .container
      .from("debian:trixie")
      .withEnvVariable("DEBIAN_FRONTEND", "noninteractive")
      .withExec(["apt-get", "update"])
      .withExec(["apt-get", "install", "-y", "--no-install-recommends", "ca-certificates", "curl"])
      .withMountedFile("/usr/local/bin/tus", Dagger.tus.cli)
  }

  basic: Void @check {
    let input = "hello from tus-rs dagger e2e\n"
    let service = self.server.asService(useEntrypoint: true)
    let client = self
      .client
      .withServiceBinding("server", service)
      .withNewFile("/tmp/input.txt", contents: input)
    let uploadUrl = client
      .withExec([
        "/usr/local/bin/tus",
        "--endpoint",
        "http://server:1080/files/",
        "upload",
        "--no-progress",
        "--output",
        "url",
        "/tmp/input.txt",
      ])
      .stdout
      .trimSuffix("\n")
    let content = client
      .withExec(["curl", "-fsS", uploadUrl])
      .stdout

    assert { content == input }
  }

  createUpload: Void @check {
    let input = "hello from tus-rs dagger create upload\n"
    let service = self.server.asService(useEntrypoint: true)
    let client = self
      .client
      .withServiceBinding("server", service)
      .withNewFile("/tmp/input.txt", contents: input)
    let uploadUrl = client
      .withExec([
        "/usr/local/bin/tus",
        "--endpoint",
        "http://server:1080/files/",
        "create",
        "--length",
        "39B",
      ])
      .stdout
      .trimSuffix("\n")
    let uploadedUrl = client
      .withExec([
        "/usr/local/bin/tus",
        "upload",
        "--no-progress",
        "--output",
        "url",
        "/tmp/input.txt",
        uploadUrl,
      ])
      .stdout
      .trimSuffix("\n")
    let content = client
      .withExec(["curl", "-fsS", uploadUrl])
      .stdout

    assert { uploadedUrl == uploadUrl }
    assert { content == input }
  }

  createInfo: Void @check {
    let service = self.server.asService(useEntrypoint: true)
    let client = self.client.withServiceBinding("server", service)
    let uploadUrl = client
      .withExec([
        "/usr/local/bin/tus",
        "--endpoint",
        "http://server:1080/files/",
        "create",
        "--length",
        "1KiB",
        "--metadata",
        "filename=created.bin",
      ])
      .stdout
      .trimSuffix("\n")
    let info = client
      .withExec([
        "/usr/local/bin/tus",
        "info",
        uploadUrl,
      ])
      .stdout
    let expected = "url: __UPLOAD_URL__\noffset: 0\nlength: 1024\nmetadata:\nfilename=created.bin\n".replace(
      "__UPLOAD_URL__",
      uploadUrl,
      1,
    )

    assert { info == expected }
  }

  createTerminate: Void @check {
    let service = self.server.asService(useEntrypoint: true)
    let client = self.client.withServiceBinding("server", service)
    let uploadUrl = client
      .withExec([
        "/usr/local/bin/tus",
        "--endpoint",
        "http://server:1080/files/",
        "create",
        "--length",
        "3",
      ])
      .stdout
      .trimSuffix("\n")
    let verify = client
      .withExec([
        "/usr/local/bin/tus",
        "terminate",
        uploadUrl,
      ])
      .withEnvVariable("UPLOAD_URL", uploadUrl)
      .withExec([
        "sh",
        "-c",
        "/usr/local/bin/tus info \"$UPLOAD_URL\" >/tmp/info.out 2>/tmp/info.err; test $? -ne 0",
      ])
      .stdout

    assert { verify == "" }
  }
}
